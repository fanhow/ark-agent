# 複製為 .env 並 chmod 600 .env；勿貼到瀏覽器或提交版本控制。
AI_PROVIDER=openai
OPENAI_API_KEY=
# 支援文字、圖片與 Responses API；可改為帳戶有權使用的模型。
OPENAI_MODEL=gpt-4.1-mini
# 相容既有 Anthropic 設定：使用時將 AI_PROVIDER 改為 anthropic。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 照片辨識使用較精確的模型；聊天仍依 OPENAI_MODEL。
OPENAI_VISION_MODEL=gpt-4.1
# 僅後端使用。請勿填入公開 Git 或前端設定。
# ARK_SHARED_SITE_URL=https://ark-agent.fanhow.chatgpt.site
# ARK_SHARED_SERVICE_TOKEN=
# ARK_SHARED_SYNC_SECRET=
