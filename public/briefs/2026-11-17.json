  "lenses": {
    "buffett": {
      "stance": -1,
      "take": "依巴菲特價值投資框架觀察，目前美股主要指數如S&P 500與那斯達克皆呈現下跌趨勢，且美國10年債殖利率持續約5.15%，顯示資本成本維持高檔，對企業估值形成壓力。然而缺乏最新企業現金流資料，無法完整評估安全邊際。",
      "watch": "著眼於企業現金流及估值安全邊際的變動，短線指數下跌顯示市場估值承壓。"
    },
    "marks": {
      "stance": 0,
      "take": "依霍華・馬克斯市場週期與鐘擺理論，市場近期價格波動反映市場情緒不穩定，尤其費城半導體指數大跌5.28%。不過，缺少信用風險和風險溢酬的即時變化數據，難以判斷風險是否已充分反映在價格中。",
      "watch": "市場情緒及信用風險的監控是關鍵，現有數據部分揭示震盪，風險溢酬情況尚不明朗。"
    },
    "dalio": {
      "stance": -1,
      "take": "依達利歐的長短期債務週期觀點，美國10年實質殖利率約2.91%且持續上升，加上Chicago Fed金融情勢指數仍為負值，但近月資金流動性無明顯改善，顯示債務負擔及資金成本仍高，對經濟成長構成阻力。缺乏最新政府債務數據限制判斷。",
      "watch": "關注實質利率與金融情勢指數，持續反映信貸成本緊縮與成長挑戰。"
    },
    "druckenmiller": {
      "stance": -1,
      "take": "依卓肯米勒聚焦流動性與央行政策角度，聯邦基金有效利率維持3.88%，10年債殖利率位於5.15%，顯示政策緊縮仍在，市場流動性壓力存在。缺乏近期政策轉折的明確訊號，短期內反應有限。",
      "watch": "央行利率政策維持高位，流動性趨緊，市場承壓明顯，需留意政策變動。"
    },
    "wood": {
      "stance": 1,
      "take": "伍德視角著眼於創新企業與長期成長，中美股當中科技股短期下跌，但可視為逢低檢視創新成長機會。然而缺少研發投入及新產品發布資訊，限制對創新動能的全面理解。",
      "watch": "逢低關注顛覆式創新企業的估值調整，挖掘長期成長空間。"
    },
    "huang": {
      "stance": 1,
      "take": "根據黃仁勳觀察，NVIDIA作為AI運算領域領先者，短期股價可能受到市場整體波動影響，但整體AI運算需求尚堅挺，資料中心投資持續。資料中缺少公司具體最新運算需求和訂單層面數據限制判斷深度。",
      "watch": "持續關注AI運算需求與資料中心更新投資趨勢，判斷長期業績基礎。"
    },
    "wei": {
      "stance": 0,
      "take": "魏哲家視角聚焦於先進製程及封裝，由於台積電11月16日價格小幅回落，且缺少最新訂單與匯率資料，難以斷定短期需求是否下滑或受到匯率影響。資料日期與供需具體變動尚未明確。",
      "watch": "持續監測先進封裝產能使用率、客戶訂單與匯率變化對營運的影響。"
    },
    "nadella": {
