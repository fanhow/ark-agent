  "lenses": {
    "buffett": {
      "stance": 1,
      "take": "依華倫・巴菲特的價值投資框架推演，台股加權指數及 S&P 500 與那斯達克指數均小幅上漲，反映企業獲利與現金流條件仍維持安全邊際。不過美國 10 年債殖利率連續穩定於 5.0%，利率重力持續控盤，估值須謹慎，且缺乏即時企業現金流及安全邊際細項數據限制了更深入判斷。",
      "watch": "企業現金流、估值與安全邊際"
    },
    "marks": {
      "stance": 0,
      "take": "霍華・馬克斯依市場週期與鐘擺的思考，不預測市場方向，而是觀察市場情緒與信用風險。現況中金融情勢指數（Chicago Fed NFCI）仍為負值，顯示信用與流動性寬鬆，但仍需關注未來總經數據及即將公布的就業與個人收入指標限制判斷的深度。",
      "watch": "市場情緒、信用風險與風險溢酬"
    },
    "dalio": {
      "stance": 0,
      "take": "瑞・達利歐框架關注長短期債務週期與實質利率狀況，10 年實質殖利率持平於 2.66%，維持高位，對長期資產估值具壓力。雖然債務與資產相關性值得關注，但缺乏更即時的債務數據與跨市場實質利率走勢，可能影響全天候配置調整的具體操作。",
      "watch": "實質利率、資產相關性與債務"
    },
    "druckenmiller": {
      "stance": 1,
      "take": "史坦利・卓肯米勒強調流動性與央行政策方向，當前聯邦基金有效利率維持在 3.88%，無明顯變動，表明央行政策暫時穩定，市場流動性相對健康。資訊仍缺乏政策會議詳細聲明與即時流動性指標，限制了對轉折點的精確判斷。",
      "watch": "流動性方向與政策轉折"
    },
    "wood": {
      "stance": 1,
      "take": "凱西・伍德以顛覆式創新與長期五年期視野分析，費城半導體指數上漲 3.6% 表示科技創新股活躍，與 ARK 方舟投資關注的創新企業成長相符。然缺少對個別新興企業財務與估值細節資料，這是限制作決策的因素。",
      "watch": "創新企業成長、估值與資金成本"
    },
    "huang": {
      "stance": 1,
      "take": "黃仁勳視角聚焦 AI 運算需求與資料中心重建，半導體類股表現強勁（台積電股價上升 0.629%），顯示市場對運算需求仍具信心。不過缺少詳細資料中心投資金額與供應鏈供應能力數據，限制對未來具體趨勢的精確判斷。",
      "watch": "運算需求、資料中心投資與供應能力"
    },
    "wei": {
      "stance": 1,
      "take": "魏哲家以先進製程與封裝供需為核心，台積電股價持續穩定上升反映良好的訂單能見度及市場需求。缺乏更即時匯率變動與關稅信息，令對未來成本與利潤判斷有所局限。",
      "watch": "先進封裝產能、訂單與匯率"
    },
    "nadella": {
      "stance": 1,
      "take": "薩蒂亞・納德拉著眼於雲端資本支出與企業採用率，根據美股大盤及科技股溫和上揚，顯示雲端商業模式受青睞。不過缺乏具體 Microsoft 雲端收入及投資回報率數據，限制了產業採用率的細緻評估。",
      "watch": "雲端採用、資本支出與投資回報"
    }
  },
